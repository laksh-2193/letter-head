  "main": "index.js",
  "scripts": {
    "build": "esbuild src/app.js --bundle --minify --format=iife --target=es2020 --outfile=app.js",
    "watch": "esbuild src/app.js --bundle --format=iife --target=es2020 --outfile=app.js --watch",
    "deploy": "npm run build && mkdir -p ../lakshaykumar.com/letterhead && rm -rf ../lakshaykumar.com/letterhead/fonts ../lakshaykumar.com/letterhead/vendor && cp -R index.html app.js styles.css fonts vendor k ../lakshaykumar.com/letterhead/",
    "set-pin": "node tools/set-pin.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@tiptap/core": "^3.32.0",
